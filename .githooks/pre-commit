#!/bin/sh
# ---------------------------------------------------------------------------
# Collection-wide pre-commit hook.
#
# Ported from Asterism/.githooks/pre-commit when Asterism/ was folded into the
# collection repo. That copy still exists as the authored original but is inert
# now, because hooks only run from the repository root's configured hooksPath.
# This file is the one that actually runs. Edit this one.
#
# Enable it (not automatic, and NOT carried by a clone -- git stores hooksPath
# in .git/config, which is never committed):
#
#     git config core.hooksPath .githooks
#
# ---------------------------------------------------------------------------
# Asterism — preservation lock
#
# asterism_job3.html is the Claude Fable 5 original, kept as an authorial
# record: a game designed end to end by a single model with no human design
# input. It is not a working file. Nothing goes in it — not a fix, not a
# typo correction, not a new constellation.
#
# All changes belong in asterism_expanded.html.
# See Asterism/CLAUDE.md, "Preservation register".
# ---------------------------------------------------------------------------

LOCKED='Asterism/asterism_job3.html'
EXPECT='d74897b0942eb83bcce2e0daa1254e548571a174'   # git blob sha1 of the original

# Blocks a CHANGE to the file, not its mere presence in a commit. The original
# has to enter history unmodified at least once to be preserved at all, so
# comparing the staged blob against the expected hash is what enforces intent
# here. (The Asterism-local version compared the path alone, which would have
# blocked the very commit that first archived the file.)
if git diff --cached --name-only | grep -qx "$LOCKED"; then
  STAGED=$(git ls-files -s "$LOCKED" | awk '{print $2}')
  if [ "$STAGED" != "$EXPECT" ]; then
    echo ''
    echo "  BLOCKED — $LOCKED is locked."
    echo ''
    echo '  This file is the preserved Claude Fable 5 original. It is kept'
    echo '  unmodified on purpose. Put your change in asterism_expanded.html.'
    echo ''
    echo "    expected  $EXPECT"
    echo "    staged    $STAGED"
    echo ''
    echo '  If you truly intend to change it:  git commit --no-verify'
    echo ''
    exit 1
  fi
fi

# Also catch a swap on disk that never got staged.
if [ -f "$LOCKED" ]; then
  ACTUAL=$(git hash-object "$LOCKED")
  if [ "$ACTUAL" != "$EXPECT" ]; then
    echo ''
    echo "  BLOCKED — $LOCKED no longer matches the preserved original."
    echo "    expected  $EXPECT"
    echo "    found     $ACTUAL"
    echo ''
    echo '  Restore it with:  git checkout -- '"$LOCKED"
    echo ''
    exit 1
  fi
fi

exit 0
