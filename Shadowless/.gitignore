# Real printed card faces, downloaded from the URLs already in data/raw/*.json.
# Derived assets, not source — ~15 MB per set, and `node tools/fetch_art.js base1`
# rebuilds them from scratch. See CLAUDE.md, Job 4g.
assets/cards/

# Trevor's own exported collection save. Personal state, not source — the game
# writes it from the collection screen's Export button. See COLLECTION.md.
Save File/

# Google Drive desktop shortcut stubs. 177 bytes of JSON holding a doc_id and an
# email — no card data of any kind, and they only resolve on Trevor's machine
# while signed in. The real spreadsheets are the .xlsx files, which ARE tracked.
*.gsheet
